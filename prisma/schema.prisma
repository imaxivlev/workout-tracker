// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid()) @db.VarChar(36)
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  firstName     String?   @map("first_name") @db.VarChar(100)
  lastName      String?   @map("last_name") @db.VarChar(100)
  avatar        String?   @db.VarChar(500)
  verified      Boolean   @default(false)
  gender        Gender?   @map("gender")
  isAdmin       Boolean   @default(false) @map("is_admin")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workouts            Workout[]
  exercises           ExerciseDict[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  clubMemberships     ClubMember[]
  consents            UserConsent[]

  @@map("users")
  @@index([email])
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("verification_tokens")
  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("password_reset_tokens")
  @@index([token])
  @@index([userId])
}

model ExerciseDict {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(255)
  isGlobal  Boolean  @default(false) @map("is_global")
  userId    String?  @map("user_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillBlocks   SkillBlock[]
  wodExercises  WodExercise[]
  
  @@unique([name, userId])
  @@map("exercises_dict")
  @@index([name])
  @@index([userId])
}

model Workout {
  id              String   @id @default(uuid()) @db.VarChar(36)
  userId          String   @map("user_id") @db.VarChar(36)
  date            String   @db.VarChar(10) // YYYY-MM-DD format
  comment         String?  @db.Text
  isClubTemplate    Boolean  @default(false) @map("is_club_template")
  isTemplateOnly    Boolean  @default(false) @map("is_template_only")
  showInLeaderboard Boolean  @default(true) @map("show_in_leaderboard")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillBlocks SkillBlock[]
  wodBlocks   WodBlock[]

  @@map("workouts")
  @@index([userId, date])
  @@index([date])
}

model SkillBlock {
  id             String   @id @default(uuid()) @db.VarChar(36)
  workoutId      String   @map("workout_id") @db.VarChar(36)
  exerciseDictId String   @map("exercise_dict_id") @db.VarChar(36)
  createdAt      DateTime @default(now()) @map("created_at")
  
  workout      Workout        @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise     ExerciseDict   @relation(fields: [exerciseDictId], references: [id])
  sets         SkillSet[]
  
  @@map("skill_blocks")
  @@index([workoutId])
  @@index([exerciseDictId])
}

model SkillSet {
  id           String  @id @default(uuid()) @db.VarChar(36)
  skillBlockId String  @map("skill_block_id") @db.VarChar(36)
  setNumber    Int     @map("set_number")
  reps         Int
  weight       Decimal @db.Decimal(6, 2) // Max 9999.99 kg
  
  weightIsPercent Boolean @default(false) @map("weight_is_percent")

  skillBlock SkillBlock @relation(fields: [skillBlockId], references: [id], onDelete: Cascade)

  @@map("skill_sets")
  @@index([skillBlockId])
}

enum WodType {
  FOR_TIME
  AMRAP
  EMOM
  TABATA
  
  @@map("wod_type")
}

enum WodLevel {
  RX
  SCALED
  
  @@map("wod_level")
}

enum ResultType {
  TIME
  REPS
  WEIGHT
  
  @@map("result_type")
}

model WodBlock {
  id               String     @id @default(uuid()) @db.VarChar(36)
  workoutId        String     @map("workout_id") @db.VarChar(36)
  wodType          WodType    @map("wod_type")
  level            WodLevel
  timeCapSeconds   Int?       @map("time_cap_seconds")
  isLadder         Boolean    @default(false) @map("is_ladder")
  ladderRounds     Int?       @map("ladder_rounds")
  resultType       ResultType @map("result_type")
  resultDisplay    String     @map("result_display") @db.VarChar(50) // "15:30" or "5+12"
  resultSeconds    Int?       @map("result_seconds") // For TIME type
  resultTotalReps  Int?       @map("result_total_reps") // For AMRAP type
  hasGenderSplit   Boolean    @default(false) @map("has_gender_split")
  createdAt        DateTime   @default(now()) @map("created_at")
  
  workout   Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercises WodExercise[]
  
  @@map("wod_blocks")
  @@index([workoutId])
}

model WodExercise {
  id             String  @id @default(uuid()) @db.VarChar(36)
  wodBlockId     String  @map("wod_block_id") @db.VarChar(36)
  exerciseDictId String  @map("exercise_dict_id") @db.VarChar(36)
  reps           Int
  weight         Decimal? @db.Decimal(6, 2)
  repsFemale     Int?     @map("reps_female")
  weightFemale   Decimal? @map("weight_female") @db.Decimal(6, 2)
  orderIndex     Int     @map("order_index") // For maintaining exercise order
  
  wodBlock WodBlock     @relation(fields: [wodBlockId], references: [id], onDelete: Cascade)
  exercise ExerciseDict @relation(fields: [exerciseDictId], references: [id])
  
  @@map("wod_exercises")
  @@index([wodBlockId])
  @@index([exerciseDictId])
}

// =====================
// Club system
// =====================

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum ClubRole {
  OWNER
  COACH
  ATHLETE

  @@map("club_role")
}

model Club {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  city        String?  @db.VarChar(100)
  logo        String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members ClubMember[]
  invites ClubInvite[]

  @@map("clubs")
  @@index([slug])
}

model ClubMember {
  id               String   @id @default(uuid()) @db.VarChar(36)
  clubId           String   @map("club_id") @db.VarChar(36)
  userId           String   @map("user_id") @db.VarChar(36)
  role             ClubRole @default(ATHLETE)
  showInLeaderboard Boolean @default(true) @map("show_in_leaderboard")
  joinedAt         DateTime @default(now()) @map("joined_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@map("club_members")
  @@index([clubId])
  @@index([userId])
}

model ClubInvite {
  id        String   @id @default(uuid()) @db.VarChar(36)
  clubId    String   @map("club_id") @db.VarChar(36)
  code      String   @unique @db.VarChar(20)
  createdBy String   @map("created_by") @db.VarChar(36)
  maxUses   Int?     @map("max_uses")
  usedCount Int      @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("club_invites")
  @@index([code])
  @@index([clubId])
}

// =====================
// User consents
// =====================

model UserConsent {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  consentType String   @map("consent_type") @db.VarChar(50) // cookies, privacy_policy, terms
  accepted    Boolean  @default(true)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_consents")
  @@index([userId])
  @@index([consentType])
}
