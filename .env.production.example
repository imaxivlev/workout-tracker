# Production Environment Configuration
# Скопируйте этот файл в .env.production и заполните реальными значениями

# Database (MySQL на Timeweb - отдельная БД для production)
DATABASE_URL="mysql://user:password@localhost:3306/workout_tracker_production"

# JWT Secret (256-bit random string)
# Сгенерируйте новый секрет: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-production-secret-key-change-this"

# App URL (production domain)
NEXT_PUBLIC_APP_URL="https://crossfitapp.ru"

# SMTP Settings (Timeweb SMTP)
SMTP_HOST="smtp.timeweb.ru"
SMTP_PORT="465"
SMTP_USER="noreply@crossfitapp.ru"
SMTP_PASSWORD="e236925zuS"

# Node Environment
NODE_ENV="production"
